# ===== 顶层 prod 部署环境变量 =====
# 复制为 .env.prod 后填值；docker-compose 会自动读取 (--env-file .env.prod)。

# 公网域名（Caddy 自动申请 Let's Encrypt 证书）
DOMAIN=demandradar.example.com
ACME_EMAIL=admin@example.com
# 浏览器/SSR 拼接 magic-link 与 CORS 都用这个，必须带协议前缀
PUBLIC_BASE_URL=https://demandradar.example.com

# 镜像 tag（CI 推镜像时覆盖；不填默认 latest）
TAG=latest

# ===== 安全密钥 =====
# 生成方法：python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=please-generate-a-32-byte-random-string

# ===== 数据库 =====
POSTGRES_USER=demandradar
POSTGRES_PASSWORD=please-set-a-strong-password
POSTGRES_DB=demandradar

# ===== LLM =====
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
LLM_DAILY_BUDGET_CNY=50

# ===== SMTP =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DemandRadar <noreply@demandradar.example.com>
SMTP_USE_TLS=true

# ===== Resend (HTTPS email API, bypasses SMTP port blocks) =====
# Preferred on hosts that block outbound SMTP (e.g. DigitalOcean).
# Free tier: 100 emails/day. Sign up at https://resend.com
RESEND_API_KEY=

# ===== Billing =====
# Full step-by-step setup (USD pricing, Stripe Tax, webhooks): see docs/STRIPE_USD_SETUP.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from your Stripe Dashboard. Leave empty if you don't sell that plan yet.
# Default catalogue:
#   STRIPE_PRICE_WEEKLY_PRO   -> $9.90 / month  (recurring)
#   STRIPE_PRICE_STUDIO       -> $29.00 / month (recurring)
#   STRIPE_PRICE_BRIEF_ONEOFF -> $29.00 one-off (payment)
STRIPE_PRICE_WEEKLY_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_BRIEF_ONEOFF=

# ===== 数据源 =====
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=demandradar/0.1
PRODUCT_HUNT_TOKEN=

# ===== D19 运营自动化（全部可选） =====
# 通用 incoming webhook（Slack/Discord/Lark）。空 = 关闭运营告警。
ADMIN_WEBHOOK_URL=
# 收每日运营摘要邮件的地址。空 = 关闭。
ADMIN_EMAIL=
# 当今天 LLM 花费占预算 ≥ 此比例时告警一次（0~1）。
LLM_BUDGET_ALERT_PCT=0.8
# 自动入队推文的 painpoint 分数阈值。
AUTO_TWEET_MIN_SCORE=80
# 注册多少小时后还没付费就发"Top 3 错过的痛点"邮件。
COLD_START_WINDOW_HOURS=48

# ===== 出站社交：X / 微博 =====
TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
WEIBO_ENABLED=false
WEIBO_ACCESS_TOKEN=

# ===== GitHub 公开 brief 同步 =====
# 启用后，评分 ≥ GITHUB_SYNC_MIN_SCORE 的 brief 会被自动 commit 到下面这个 repo。
# 用 fine-grained PAT，仅授予该 repo 的 contents:write 权限。
GITHUB_SYNC_ENABLED=false
GITHUB_SYNC_TOKEN=
GITHUB_SYNC_REPO=demandradar/briefs
GITHUB_SYNC_BRANCH=main
GITHUB_SYNC_MIN_SCORE=80

# ===== 备份 sidecar =====
# 间隔/保留天数 + 可选 S3 上传（兼容 R2/MinIO/阿里云 OSS）
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ===== 可观测性 =====
# Sentry DSN，留空则不启用
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# ===== 前端宣发与统计（NEXT_PUBLIC_ 开头会注入到浏览器） =====
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# 百度统计 ID（中国大陆访客）
NEXT_PUBLIC_BAIDU_ID=
# 社交媒体链接，用于 footer 图标
NEXT_PUBLIC_X_URL=https://x.com/demandradar
NEXT_PUBLIC_GITHUB_URL=https://github.com/demandradar
NEXT_PUBLIC_DISCORD_URL=
# 媒体联络与撤稿邮箱（在 footer / press 页面公开展示）
NEXT_PUBLIC_PRESS_EMAIL=press@demandradar.example.com
NEXT_PUBLIC_TAKEDOWN_EMAIL=takedown@demandradar.example.com

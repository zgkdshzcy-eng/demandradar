# ===== App =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-please

# ===== Database =====
POSTGRES_USER=demandradar
POSTGRES_PASSWORD=demandradar
POSTGRES_DB=demandradar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://demandradar:demandradar@localhost:5432/demandradar

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== LLM =====
# DeepSeek (主力，成本优先)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anthropic (项目书复检)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI 兼容（可选备用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# D17: Aliyun DashScope（第四 provider，OpenAI-兼容）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Embeddings（OpenAI 兼容接口；可指 OpenAI / DashScope / 自部署）
# 默认 1024 维匹配 DB schema；OpenAI 3-small 通过 dimensions 参数降到 1024。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024

# 每日 LLM 预算上限（人民币元）
LLM_DAILY_BUDGET_CNY=50

# ===== SMTP（发周报用） =====
# 不配则邮件发送跳过，仅生成入库；配了才真发。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DemandRadar <noreply@example.com>
SMTP_USE_TLS=true

# ===== D15 运营自动化 =====
# X (Twitter) 自动发帖。TWITTER_ENABLED=false 时仅入队 status=manual，admin 看板可手抄。
TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=
# 用户级 OAuth2 access token（包含 tweet.write 范围），调 POST /2/tweets 必需。
TWITTER_ACCESS_TOKEN=
# 周报分发限速（每分钟封顶）+ 单次运行最多发多少封。
NEWSLETTER_DISPATCH_PER_MINUTE=60
NEWSLETTER_MAX_PER_RUN=2000

# ===== 可观测性（D11） =====
# Sentry 留空则不启用
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# json 用于生产日志聚合，dev 用 text
LOG_FORMAT=text
LOG_LEVEL=
METRICS_ENABLED=true

# 多实例部署时只有 worker 进程跑 scheduler，api 容器置 1 即可
APP_SCHEDULER_DISABLED=

# ===== D19 运营自动化（全部可选） =====
# Slack/Discord/Lark 通用 incoming webhook。空 = 关闭运营告警。
ADMIN_WEBHOOK_URL=
# 收每日运营摘要邮件的地址。空 = 关闭。
ADMIN_EMAIL=
# 当今天 LLM 花费占预算 ≥ 此比例时告警一次（0~1）。
LLM_BUDGET_ALERT_PCT=0.8
# 自动入队推文的 painpoint 分数阈值。
AUTO_TWEET_MIN_SCORE=80
# 注册多少小时后还没付费就发"Top 3 错过的痛点"邮件。
COLD_START_WINDOW_HOURS=48

# ===== Billing / public domain =====
# Empty -> redeem-code-only mode (admin issues codes manually).
# Full step-by-step setup (USD pricing, Stripe Tax, webhooks): see docs/STRIPE_USD_SETUP.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from your Stripe Dashboard (Products -> Prices). Empty = checkout disabled for that plan.
# Default catalogue:
#   STRIPE_PRICE_WEEKLY_PRO   -> $9.90 / month  (recurring)
#   STRIPE_PRICE_STUDIO       -> $29.00 / month (recurring)
#   STRIPE_PRICE_BRIEF_ONEOFF -> $29.00 one-off (payment)
STRIPE_PRICE_WEEKLY_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_BRIEF_ONEOFF=
PUBLIC_BASE_URL=http://localhost:3000

# ===== 数据源凭据 =====
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=demandradar/0.1
PRODUCT_HUNT_TOKEN=

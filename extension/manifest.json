{
  "manifest_version": 3,
  "name": "DemandRadar Scout",
  "version": "1.0.0",
  "description": "Browse HN/ProductHunt/V2EX — see real-time demand insights in the sidebar",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://news.ycombinator.com/*",
    "https://www.producthunt.com/*",
    "https://www.v2ex.com/*",
    "https://lobste.rs/*",
    "https://www.indiehackers.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://news.ycombinator.com/*",
        "https://www.producthunt.com/*",
        "https://www.v2ex.com/*",
        "https://lobste.rs/*",
        "https://www.indiehackers.com/*"
      ],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
